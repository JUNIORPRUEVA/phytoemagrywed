# ---------------------------------------------------------------------------
# Phytoemagry — variables de BUILD (todas son PÚBLICAS: acaban en el navegador)
# Copia este archivo como `.env` y completa lo que exista de verdad.
# Si dejas una variable vacía, la función asociada NO se renderiza
# (nunca mostramos datos inventados).
# ---------------------------------------------------------------------------

# Número de WhatsApp en formato internacional SOLO dígitos (código país + número).
# Ejemplo de formato: 56912345678  -> https://wa.me/56912345678
PHYTO_WHATSAPP_NUMBER=

# Endpoint público del mini-CRM que recibirá leads / intenciones de pedido.
# `/api/crm` (lo que trae la imagen Docker) guarda los datos en la base de datos
# SQLite del contenedor. También vale la URL completa de un CRM externo
# (Google Sheets, Make/Zapier/n8n, tu propio backend). Ver docs/CRM-CONTRACT.md.
# Si lo dejas vacío, la landing funciona en modo "cola local" (guarda en el
# navegador y no envía nada a ningún servidor).
PHYTO_CRM_ENDPOINT=

# Meta Pixel ID. Si está vacío, NO se carga ningún script de Meta.
PHYTO_META_PIXEL_ID=

# URL canónica del sitio (sin barra final). Necesaria para canonical + sitemap.
SEO_SITE_URL=

# Email de contacto comercial visible. Vacío => no se muestra.
CONTACT_EMAIL=

# development | production
APP_ENV=production

# ---------------------------------------------------------------------------
# API del CRM (SOLO servidor: `server/crm-server.mjs`; no llega al navegador)
# Estas variables NO van en el build: se pasan al contenedor al arrancar
# (`docker run -e` o Environment de Easypanel).
# ---------------------------------------------------------------------------

# Clave para LEER los datos: /panel?token=... y /api/crm/export.csv?token=...
# Sin ella, los pedidos y los contactos se siguen guardando, pero no se pueden
# consultar. Pon una larga y solo tuya (ej.: 40 caracteres al azar).
PHYTO_CRM_TOKEN=

# Ruta del archivo de datos. En la imagen Docker es /data/phytoemagry.sqlite
# (monta ahí un volumen). Con extensión .jsonl usa un archivo de texto.
PHYTO_CRM_DATA=/data/phytoemagry.sqlite

# Puerto e interfaz del API (nginx le hace de proxy: no lo expongas a internet).
PHYTO_CRM_PORT=8787
PHYTO_CRM_HOST=127.0.0.1

# Solo si la web se sirve desde OTRO dominio y el API desde este (CORS).
# Ejemplo: PHYTO_CRM_ALLOWED_ORIGIN=https://phytoemagry.com
PHYTO_CRM_ALLOWED_ORIGIN=
