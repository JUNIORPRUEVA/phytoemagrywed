# ---------------------------------------------------------------------------
# Phytoemagry — variables de BUILD (todas son PÚBLICAS: acaban en el navegador)
# Copia este archivo como `.env` y completa lo que exista de verdad.
# Si dejas una variable vacía, la función asociada NO se renderiza
# (nunca mostramos datos inventados).
# ---------------------------------------------------------------------------

# Número de WhatsApp en formato internacional SOLO dígitos (código país + número).
# Ejemplo de formato: 56912345678  -> https://wa.me/56912345678
PHYTO_WHATSAPP_NUMBER=

# Endpoint público del mini-CRM que recibirá leads / intenciones de pedido.
# `/api/crm` (lo que trae la imagen Docker) guarda los datos en la base de datos
# SQLite del contenedor. También vale la URL completa de un CRM externo
# (Google Sheets, Make/Zapier/n8n, tu propio backend). Ver docs/CRM-CONTRACT.md.
# Si lo dejas vacío, la landing funciona en modo "cola local" (guarda en el
# navegador y no envía nada a ningún servidor).
PHYTO_CRM_ENDPOINT=

# Meta Pixel ID. Si está vacío, NO se carga ningún script de Meta y no aparece el
# banner de consentimiento. Es PÚBLICO (viaja en el HTML) y se incrusta en el
# BUILD: cambiarlo exige volver a desplegar.
PHYTO_META_PIXEL_ID=

# API de conversiones de Meta (SOLO SERVIDOR: `server/crm-server.mjs`).
# SECRETO: nunca debe llegar al navegador, a un log ni a un mensaje de error.
# Events Manager → Orígenes de datos → tu píxel → Configuración → API de conversiones.
PHYTO_META_CAPI_ACCESS_TOKEN=
# Código de eventos de prueba (`TEST12345`). Solo UAT: con APP_ENV=production se IGNORA.
PHYTO_META_CAPI_TEST_EVENT_CODE=
# Versión de la Graph API (opcional; por defecto v21.0).
PHYTO_META_GRAPH_VERSION=
# Estado del CRM que representa una VENTA real (por defecto: entregado).
PHYTO_META_PURCHASE_STATUS=

# URL canónica del sitio (sin barra final). Necesaria para canonical + sitemap.
SEO_SITE_URL=

# Email de contacto comercial visible. Vacío => no se muestra.
CONTACT_EMAIL=

# development | production
APP_ENV=production

# ---------------------------------------------------------------------------
# API del CRM (SOLO servidor: `server/crm-server.mjs`; no llega al navegador)
# Estas variables NO van en el build: se pasan al contenedor al arrancar
# (`docker run -e` o Environment de Easypanel).
# ---------------------------------------------------------------------------

# Clave para LEER los datos: /panel?token=... y /api/crm/export.csv?token=...
# Sin ella, los pedidos y los contactos se siguen guardando, pero no se pueden
# consultar. Pon una larga y solo tuya (ej.: 40 caracteres al azar).
PHYTO_CRM_TOKEN=

# Usuario inicial/sincronizado del panel. Si existen, al arrancar el CRM asegura
# que ese usuario sea ADMIN y que la contraseña sea la del entorno.
PHYTO_CRM_BOOTSTRAP_ADMIN_USER=
PHYTO_CRM_BOOTSTRAP_ADMIN_PASSWORD=

# Base de datos PostgreSQL (producción recomendada): los pedidos y los contactos
# se guardan ahí, no dentro del contenedor. Ejemplo:
#   postgres://phytoemagry_user:CLAVE@ventas_studio-db:5432/phytoemagry
# Si la dejas vacía, se usa SQLite en PHYTO_CRM_DATA (necesita un volumen).
PHYTO_CRM_DATABASE_URL=

# Ruta del archivo de datos cuando NO hay PostgreSQL (y no se usa .jsonl).
PHYTO_CRM_DATA=/data/phytoemagry.sqlite

# Puerto e interfaz del API (nginx le hace de proxy: no lo expongas a internet).
PHYTO_CRM_PORT=8787
PHYTO_CRM_HOST=127.0.0.1

# Solo si la web se sirve desde OTRO dominio y el API desde este (CORS).
# Ejemplo: PHYTO_CRM_ALLOWED_ORIGIN=https://phytoemagry.com
PHYTO_CRM_ALLOWED_ORIGIN=

# Zona horaria del negocio (por defecto America/Santo_Domingo).
PHYTO_CRM_TZ=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (SOLO servidor; ver docs/WHATSAPP_INTEGRATION.md)
#
# NADA se envía automáticamente: estas variables solo permiten RECIBIR los
# mensajes del cliente y ENVIAR cuando una persona pulsa Enviar en el panel.
# Si están vacías, el CRM sigue funcionando (clientes, compras y seguimiento)
# pero el panel no envía ni recibe WhatsApp: lo dice claramente en pantalla.
# ---------------------------------------------------------------------------

# App de Meta (developers.facebook.com → tu app). El ID es público; el SECRETO
# sirve para comprobar que el webhook lo manda Meta de verdad.
META_APP_ID=
META_APP_SECRET=

# Cuenta de WhatsApp Business (WABA) y número que envía.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Número visible del negocio, solo dígitos con código de país (ej.: 18095550000).
WHATSAPP_PHONE_NUMBER=

# Token de envío (SECRETO: solo en el servidor, nunca en el navegador).
WHATSAPP_ACCESS_TOKEN=

# Secreto que se escribe en el panel de Meta al crear el webhook. Si no coincide,
# Meta no puede verificar la URL y no llegan mensajes.
WHATSAPP_VERIFY_TOKEN=

# URL pública del webhook (informativa; la que se registra en Meta).
WHATSAPP_WEBHOOK_URL=

# Versión de la Graph API para WhatsApp (si se deja vacía se usa la de Meta).
WHATSAPP_GRAPH_VERSION=

# ---------------------------------------------------------------------------
# Seguimiento (tareas para una persona; el sistema NUNCA envía solo)
# ---------------------------------------------------------------------------

# Plan de seguimiento por venta entregada, en JSON. Cada entrada es un día
# después de la entrega. Sin esta variable se usa el plan de casa:
# día 1 agradecimiento, 3 ¿cómo va?, 7 información, 14 seguimiento, 21
# información, 30 recompra.
# Ejemplo: [{"key":"d1","day":1,"type":"thanks","reason":"Agradecer"},{"key":"d7","day":7,"type":"checkin","reason":"Ver cómo va"}]
PHYTO_FOLLOWUP_PLAN=

# Cápsulas por día (el uso aprobado del producto es 1). Se usa para estimar
# cuánto dura un frasco y cuándo toca la próxima compra.
PHYTO_DAILY_CAPSULES=
