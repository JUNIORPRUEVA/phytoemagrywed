# ---------------------------------------------------------------------------
# Phytoemagry — variables de BUILD (todas son PÚBLICAS: acaban en el navegador)
# Copia este archivo como `.env` y completa lo que exista de verdad.
# Si dejas una variable vacía, la función asociada NO se renderiza
# (nunca mostramos datos inventados).
# ---------------------------------------------------------------------------

# Número de WhatsApp en formato internacional SOLO dígitos (código país + número).
# Ejemplo de formato: 56912345678  -> https://wa.me/56912345678
PHYTO_WHATSAPP_NUMBER=

# Endpoint público del mini-CRM que recibirá leads / intenciones de pedido.
# Mientras esté vacío, la landing funciona en modo "cola local" (guarda en el
# navegador y no envía nada a ningún servidor).
PHYTO_CRM_ENDPOINT=

# Meta Pixel ID. Si está vacío, NO se carga ningún script de Meta.
PHYTO_META_PIXEL_ID=

# URL canónica del sitio (sin barra final). Necesaria para canonical + sitemap.
SEO_SITE_URL=

# Email de contacto comercial visible. Vacío => no se muestra.
CONTACT_EMAIL=

# development | production
APP_ENV=production
