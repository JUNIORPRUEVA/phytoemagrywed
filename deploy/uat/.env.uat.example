# PLANTILLA de entorno UAT — copiar como `.env.uat` y rellenar.
# NO versionar `.env.uat` (contiene credenciales). Este archivo no tiene secretos.
#
# Regla de oro: TODO lo de este entorno es de pruebas. Nada de datos reales de
# clientes, nada de WhatsApp real, nada de la base de producción.

# Identificación explícita del entorno.
APP_ENV=uat
PHYTO_PUBLIC_URL=https://<dominio-uat>          # el que dé el ingress de la plataforma
PHYTO_CRM_ALLOWED_ORIGIN=https://<dominio-uat>
PHYTO_CRM_TZ=America/Santo_Domingo
PHYTO_TRUSTED_PROXIES=1                          # el ingress está delante

# --- Credenciales de UAT (generar nuevas; nunca reutilizar las de producción) ---
PHYTO_CRM_TOKEN=<token-largo-aleatorio-uat>
PHYTO_CRM_BOOTSTRAP_ADMIN_USER=uat-admin
PHYTO_CRM_BOOTSTRAP_ADMIN_PASSWORD=<clave-larga-aleatoria-uat>
PHYTO_UAT_DB_PASSWORD=<clave-postgres-uat>

# --- Sin integraciones reales ---
# Se dejan VACÍAS a propósito: el CRM las desactiva solo y no se envía nada.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
PHYTO_META_CAPI_ACCESS_TOKEN=

# --- Correo/SMS opcionales (dejar vacíos si no se prueban) ---
# STORE_SMTP_URL=
# STORE_SMS_PROVIDER_URL=

# --- Web Push opcional ---
PHYTO_WEB_PUSH_PUBLIC_KEY=
PHYTO_WEB_PUSH_PRIVATE_KEY=
PHYTO_WEB_PUSH_SUBJECT=
