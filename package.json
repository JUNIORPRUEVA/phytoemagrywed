{
  "name": "phytoemagry-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page comercial de Phytoemagry (V1) — estática, rápida, medible.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:datos": "node scripts/uat-env.mjs --copiar-datos",
    "uat": "node scripts/uat-env.mjs",
    "uat:reset": "node scripts/uat-env.mjs --reset",
    "crm": "node --experimental-sqlite server/crm-server.mjs",
    "preview": "node scripts/dev.mjs --dist --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "smoke:r2": "node scripts/r2-smoke.mjs",
    "import:historical-whatsapp": "node --experimental-sqlite scripts/import-historical-whatsapp-contacts.mjs",
    "configure:fulltech-whatsapp-profile": "node scripts/configure-fulltech-whatsapp-profile.mjs",
    "audit:historical-whatsapp:prod": "node scripts/audit-historical-whatsapp-production.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "inspect:render": "node scripts/inspect-render.mjs",
    "verify": "npm run test && npm run check && npm run build",
    "verify:deploy": "npm run check && npm run build",
    "images": "python scripts/generate-placeholder-images.py",
    "images:hero": "python scripts/optimize-hero-image.py",
    "images:frascos": "python scripts/optimize-variant-images.py",
    "images:admin": "python scripts/generate-admin-icons.py",
    "icons:store": "node scripts/build-store-icons.mjs",
    "icons:material": "node scripts/fetch-material-symbols.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "lucide-static": "^1.60.0",
    "pdfjs-dist": "^6.4.299",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dictionary-es-do": "^2.0.0",
    "leaflet": "^1.9.4",
    "nspell": "^2.1.5",
    "pg": "^8.23.0",
    "web-push": "^3.6.7"
  }
}
